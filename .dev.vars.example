# Copy to `.dev.vars` and fill in. `.dev.vars` is gitignored.
# For a deployed Worker use `npx wrangler secret put ANTHROPIC_API_KEY` instead.
ANTHROPIC_API_KEY=sk-ant-...

# Signs room access tokens. Anyone who has this can mint a token for any room,
# so treat it like a password. Changing it invalidates every existing session
# — everyone currently connected gets kicked back to the join screen.
ROOM_SECRET=change-me-to-a-long-random-string

# Optional: enables GitHub repository workspaces through a GitHub App.
# Leave these blank if you only want local-folder workspaces.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# Optional sign-in providers. The callback URL must also be registered with
# each provider. For local Vite development, use:
# http://localhost:5173/api/auth/google/callback
# http://localhost:5173/api/auth/github/callback
# If you open 127.0.0.1 instead, register the equivalent 127.0.0.1 URLs.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
