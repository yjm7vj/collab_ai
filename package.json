{
  "name": "collab-ai",
  "version": "1.0.0",
  "description": "Multiplayer AI: many people, one shared agent.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy -c dist/collab_ai/wrangler.json",
    "typecheck": "wrangler types && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "check": "esbuild scripts/check-settings.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check.mjs --log-level=warning && node node_modules/.cache/check.mjs",
    "check:auth": "esbuild scripts/check-auth.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check-auth.mjs --log-level=warning && node node_modules/.cache/check-auth.mjs",
    "check:workflow": "esbuild scripts/check-workflow.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check-workflow.mjs --log-level=warning && node node_modules/.cache/check-workflow.mjs",
    "check:workspace": "esbuild scripts/check-workspace.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check-workspace.mjs --log-level=warning && node node_modules/.cache/check-workspace.mjs",
    "test": "npm run check && npm run check:auth && npm run check:workflow && npm run check:workspace && npm run check:fs && npm run check:github && npm run check:oauth && npm run check:docx && npm run check:markdown",
    "test:integration": "vitest run",
    "check:fs": "esbuild scripts/check-fs-provider.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check-fs.mjs --log-level=warning --external:node:fs --external:node:path --external:node:os && node node_modules/.cache/check-fs.mjs",
    "check:github": "esbuild scripts/check-github.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check-github.mjs --log-level=warning --external:node:fs --external:node:path --external:node:os && node node_modules/.cache/check-github.mjs",
    "check:oauth": "esbuild scripts/check-oauth.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check-oauth.mjs --log-level=warning && node node_modules/.cache/check-oauth.mjs",
    "check:markdown": "esbuild scripts/check-markdown.ts --bundle --format=esm --platform=node --jsx=automatic --outfile=node_modules/.cache/check-markdown.mjs --log-level=warning && node node_modules/.cache/check-markdown.mjs",
    "check:docx": "esbuild scripts/check-docx.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/check-docx.mjs --log-level=warning && node node_modules/.cache/check-docx.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjm7vj/collab_ai.git"
  },
  "keywords": [
    "ai",
    "collaboration",
    "cloudflare-workers",
    "durable-objects",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/yjm7vj/collab_ai/issues"
  },
  "homepage": "https://github.com/yjm7vj/collab_ai#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "agents": "^0.20.1",
    "docx": "^9.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  },
  "private": true
}
