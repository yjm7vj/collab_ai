{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collab-ai",
  // Deploys to the account that owns the huddleai.org zone, not to whichever
  // account the local wrangler login happens to default to. The worker of this
  // name there is the one already serving app.huddleai.org, so a deploy updates
  // it in place and keeps its Durable Object storage — the live rooms.
  "account_id": "43c1ccdc0ceb55bce8cb6f05beaed231",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The Worker owns routing: it answers /agents/* and /api/* itself and hands
    // everything else to the asset server, which is also the SPA fallback.
    // /api/* must be listed here — room creation and joining are Worker routes,
    // and without it the asset server answers them and no room can ever be made.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },

  // Two hostnames, one Worker, one bundle. app.huddleai.org is the product;
  // huddleai.org is the same landing page ending in a waitlist form instead of
  // a sign-in, chosen client-side by hostname (src/client/host.ts). Taking the
  // apex means this Worker now displaces whatever the huddleai.org DNS record
  // pointed at before — deploying is what moves it, so check that first.
  // `zone_name` is required: the zone cannot be inferred from a pattern.
  "routes": [
    { "pattern": "app.huddleai.org", "custom_domain": true, "zone_name": "huddleai.org" },
    { "pattern": "huddleai.org", "custom_domain": true, "zone_name": "huddleai.org" }
  ],

  // Pinned on: adding any route silently disables the *.workers.dev URL, which
  // 404s the address the app is currently reachable at.
  "workers_dev": true,

  // Waitlist signups from the apex. Nothing else in the app uses D1, and the
  // binding is deliberately optional at runtime: /api/waitlist answers 503 when
  // it is missing rather than taking the rest of the Worker down with it.
  // Schema changes go in migrations/, applied with
  // `npx wrangler d1 migrations apply huddleai-waitlist --remote`.
  "d1_databases": [
    {
      "binding": "WAITLIST_DB",
      "database_name": "huddleai-waitlist",
      "database_id": "e26f0d5f-ab0c-4bcb-b356-1a5edf76a281",
      "migrations_dir": "migrations"
    }
  ],

  // Room is one object per room. UserIndex is one per signed-in account: the
  // reverse map, from a uid to the rooms and projects that account knows about,
  // so a sidebar follows the person to a second browser instead of living only
  // in the first one's localStorage.
  "durable_objects": {
    "bindings": [
      { "name": "Room", "class_name": "Room" },
      { "name": "UserIndex", "class_name": "UserIndex" },
      { "name": "ProjectIndex", "class_name": "ProjectIndex" }
    ]
  },

  // Never edit a migration that has shipped — add a new tag instead.
  //
  // v3 registered Sandbox for the interactive-terminal feature, which ran in
  // Cloudflare Containers. Containers require the Workers Paid plan, which
  // this deployment does not have, so the feature is removed rather than left
  // undeployable — v4 decommissions the class properly instead of just
  // deleting its history, per Cloudflare's own migration rules.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["UserIndex"] },
    { "tag": "v3", "new_sqlite_classes": ["Sandbox"] },
    { "tag": "v4", "deleted_classes": ["Sandbox"] },
    { "tag": "v5", "new_sqlite_classes": ["ProjectIndex"] }
  ],

  "observability": { "enabled": true }

}
