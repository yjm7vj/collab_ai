{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collab-ai",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The Worker owns routing: it answers /agents/* and /api/* itself and hands
    // everything else to the asset server, which is also the SPA fallback.
    // /api/* must be listed here — room creation and joining are Worker routes,
    // and without it the asset server answers them and no room can ever be made.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },

  // The app answers on app.huddleai.org. Deliberately a subdomain: the apex
  // serves a different site that is not in this repo, so this displaces
  // nothing. `zone_name` is required — the zone cannot be inferred from a
  // subdomain pattern.
  "routes": [
    { "pattern": "app.huddleai.org", "custom_domain": true, "zone_name": "huddleai.org" }
  ],

  // Pinned on: adding any route silently disables the *.workers.dev URL, which
  // 404s the address the app is currently reachable at.
  "workers_dev": true,

  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },

  // Never edit a migration that has shipped — add a new tag instead.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "observability": { "enabled": true }

}
