{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collab-ai",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The Worker owns routing: it answers /agents/* itself and hands
    // everything else to the asset server, which is also the SPA fallback.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },

  // Never edit a migration that has shipped — add a new tag instead.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "observability": { "enabled": true }

}
