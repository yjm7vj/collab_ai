{
  "permissions": {
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Edit(./.dev.vars)",
      "Edit(./.dev.vars.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/deny-secrets.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
